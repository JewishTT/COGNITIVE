# COGNITIVE PLATFORM - API SERVER DOCKERFILE

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci --only=production

# Copy source code
COPY core ./core
COPY config ./config
COPY platform/src/server ./platform/src/server

# Build TypeScript
RUN npm run build || true

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8000/api/v1/health', (r) => process.exit(r.statusCode < 500 ? 0 : 1))"

# Start server
CMD ["node", "platform/src/server/app.ts"]

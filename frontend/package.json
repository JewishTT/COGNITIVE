{
  "name": "cognitive-frontend",
  "version": "1.0.0",
  "description": "COGNITIVE Frontend - Vue 3 + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint frontend/src --ext .vue,.js,.ts",
    "test": "vitest",

    "pinia": "^2.1.7",
    "three": "^0.159.0",
    "vue": "^3.4.0",
    "vue-flow": "^0.1.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.0",
    "jsdom": "^23.0.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",

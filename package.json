{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.1.0",
  "description": "A real-time intelligence console for planet Earth — photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/bilawalsidhu/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilawalsidhu/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/bilawalsidhu/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "dev": "vite --open /",
    "dev:globe": "vite --host localhost --port 4173",
    "dev:platform": "vite --config platform/vite.platform.config.js",
    "dev:pipeline": "node platform/pipeline-server/index.mjs",
    "dev:factory": "docker compose -f platform/factory/docker-compose.yaml up -d",
    "dev:factory:down": "docker compose -f platform/factory/docker-compose.yaml down",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "cesium": "^1.124.0",
    "dotenv": "^17.4.2",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}

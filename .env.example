# COGNITIVE PLATFORM - ENVIRONMENT CONFIGURATION

# Environment
NODE_ENV=development
LOG_LEVEL=info

# API Server
PORT=8000
API_PREFIX=/api/v1

# OSINT Service
OSINT_URL=http://localhost:5001
OSINT_TIMEOUT=30000
OSINT_RETRY=3

# Neo4j Graph Database
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Pipeline Server
PIPELINE_URL=http://localhost:5001
PIPELINE_PORT=5001
PIPELINE_TIMEOUT=120000
PIPELINE_VENV=./.pipeline-venv
PIPELINE_CRAWL_MAX_PAGES=12
PIPELINE_CRAWL_CONCURRENCY=4
PIPELINE_CRAWL_TIMEOUT_MS=8000
PIPELINE_CRAWL_MAX_IMAGES=4

# Flowsint Graph Engine
FLOWSINT_API=http://localhost:5001
FLOWSINT_ADMIN_EMAIL=admin@ghostseven.io
FLOWSINT_ADMIN_PASSWORD=Ghost7Admin!2026

# SearXNG (optional meta-search)
SEARXNG_URL=
SEARXNG_JSON=

# Service Registry
SERVICE_REGISTRY_HEALTH_CHECK_INTERVAL=30000
SERVICE_REGISTRY_CIRCUIT_BREAKER_THRESHOLD=5
SERVICE_REGISTRY_CIRCUIT_BREAKER_TIMEOUT=60000
SERVICE_REGISTRY_MAX_RETRIES=3

# Google Maps API (Globe)
GOOGLE_MAPS_API_KEY=
GLOBE_URL=http://localhost:8080
GLOBE_TIMEOUT=30000

# OpenAI (Voice)
OPENAI_API_KEY=

# Platform Factory (Postiz)
POSTIZ_URL=http://localhost:4007
POSTIZ_ADMIN_EMAIL=admin@gev.local
POSTIZ_ADMIN_PASSWORD=PostizAdmin123

# Database (optional)
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

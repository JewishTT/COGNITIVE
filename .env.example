# ============================================================================
# COGNITIVE PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# [38;5;240mUnified Configuration for All Services[0m
# 
# This file contains all environment variables for the COGNITIVE platform.
# Copy this file to .env and update the values for your environment.
#
# ============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------

# Environment
NODE_ENV=development

# Application port
PORT=8000
HOST=0.0.0.0

# API configuration
API_PREFIX=/api/v1
API_TIMEOUT=30000

# Frontend configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=COGNITIVE Platform
VITE_APP_VERSION=2.0.0

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------

# Neo4j configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30000

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------

# Redis configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_MEMORY=256mb

# ------------------------------------------------------------------------------
# CESIUM (3D Globe)
# ------------------------------------------------------------------------------

# Cesium ion token (get from https://cesium.com/ion/)
CESIUM_TOKEN=
CESIUM_BASE_URL=https://cesium.com

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------

# JWT configuration
JWT_SECRET=cognitive-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session configuration
SESSION_SECRET=cognitive-session-secret
CSRF_ENABLED=true
HELMET_ENABLED=true

# ------------------------------------------------------------------------------
# CACHE
# ------------------------------------------------------------------------------

# Cache backend: memory, localStorage, redis, hybrid
CACHE_BACKEND=hybrid
CACHE_TTL=3600
CACHE_MAX_SIZE=256
CACHE_PRIMARY=memory
CACHE_FALLBACK=localStorage,redis

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/cognitive.log

# ------------------------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------------------------

METRICS_ENABLED=false
METRICS_PORT=9090

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=*

# ------------------------------------------------------------------------------
# PIPELINE
# ------------------------------------------------------------------------------

PIPELINE_WORKERS=4
PIPELINE_MAX_QUEUE_SIZE=100
PIPELINE_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# TDA (Topological Data Analysis)
# ------------------------------------------------------------------------------

TDA_MAX_SIMPLICES=10000
TDA_DEFAULT_RADIUS=1.0
TDA_PERSISTENCE_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# AI / FACTORY
# ------------------------------------------------------------------------------

AI_MAX_CONCURRENT_REQUESTS=10
AI_REQUEST_TIMEOUT=60000

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Local AI configuration (for offline models)
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama3

# ------------------------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------------------------

# Storage backend: neo4j, redis, local, s3, mongo
STORAGE_TYPE=neo4j
STORAGE_PATH=./data/storage

# S3 configuration (if using S3 storage)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cognitive-data

# ------------------------------------------------------------------------------
# FEATURES
# ------------------------------------------------------------------------------

# Enable/disable features
FEATURE_TDA_ENABLED=true
FEATURE_AI_ENABLED=true
FEATURE_GLOBE_ENABLED=true
FEATURE_PIPELINE_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------

# Debug mode
DEBUG=false
DEBUG_PORT=9229

# ------------------------------------------------------------------------------
# DOCKER SPECIFIC
# ------------------------------------------------------------------------------

# For Docker Compose, use service names as hosts
# NEO4J_URI=bolt://neo4j:7687
# REDIS_URL=redis://redis:6379
# VITE_API_URL=http://api:8000
# VITE_WS_URL=ws://api:8000

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Production configuration:
# NODE_ENV=production
# PORT=8080
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=strong-password-here
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=redis-password
# JWT_SECRET=very-long-random-secret-key
# CESIUM_TOKEN=your-cesium-ion-token
# LOG_LEVEL=info
# CACHE_BACKEND=redis

# Development configuration:
# NODE_ENV=development
# PORT=8000
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=dev-secret
# CESIUM_TOKEN=
# LOG_LEVEL=debug
# CACHE_BACKEND=hybrid

# ============================================================================
